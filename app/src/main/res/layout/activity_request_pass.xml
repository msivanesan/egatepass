<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="user"
            type="com.retroboys.egatpass.Users" />
    </data>

<androidx.constraintlayout.widget.ConstraintLayout

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bakground1"
    tools:context=".ActivityRequestPass">

    <include
        android:id="@+id/card_detail_layout"
        app:user="@{user}"
        layout="@layout/card_layout_user_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="150dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toBottomOf="@+id/card_detail_layout">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:paddingLeft="20dp"
            android:textStyle="bold"
            android:padding="10dp"
            android:background="@drawable/outline_with_flat_bottum"
            android:text="Reasan"
            android:textSize="20dp" />

        <EditText
            android:id="@+id/student_reason"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@drawable/outline_with_flat_top"
            android:layout_marginHorizontal="20dp"
            android:hint="Enter your reason" />

        <Button
            android:id="@+id/student_submit"
            android:layout_width="wrap_content"
            android:text="Submit"
            android:gravity="center"
            android:textSize="20dp"
            android:backgroundTint="@color/blue"
            android:layout_marginTop="20dp"
            android:layout_height="wrap_content"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
</layout>